{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypingPanicPet",
  "version": "0.5.0",
  "identifier": "dev.kk.typingpanicpet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Typing Panic Pet",
        "width": 200,
        "height": 230,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "打字越快越慌的桌面宠物",
    "category": "Entertainment"
  }
}